# ESIM Environment Configuration
#
# Copy this file to ONE of:
#   ~/.config/env/esim.env   (recommended — works regardless of working directory)
#   .env                    (repo-local fallback for development)
#
# The config directory path is checked first.
# To create it:  mkdir -p ~/.config/env && cp .env.example ~/.config/env/esim.env

# ─── Neo4j ────────────────────────────────────────────────────
# Cloud (Neo4j Aura)
# NEO4J_DB_CONNECTION_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_DB_USERNAME=neo4j
# NEO4J_DB_PASSWORD=your-password

# Local (Docker Compose)
NEO4J_DB_CONNECTION_URI=bolt://localhost:7687
NEO4J_DB_USERNAME=neo4j
NEO4J_DB_PASSWORD=password

# ─── LLM Provider ────────────────────────────────────────────
# Any OpenAI-compatible API works: OpenAI, OpenRouter, Ollama, LM Studio, vLLM

# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-api-key
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# LLM_EMBEDDING_DIMENSIONS=1536
# LLM_COMPLETION_MODEL=gpt-4o-mini

# ─── Fully Local LLM (Ollama) ────────────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_EMBEDDING_DIMENSIONS=1024
LLM_COMPLETION_MODEL=llama3.2

# Embedding input cap. Long inputs crash some local runners (a qwen3-embedding:8b
# runner died above ~9k chars of prose); text is cut at a paragraph or word
# boundary before being sent. Default 6000. Raise for hosted APIs, which are far
# more generous and reject overlong input cleanly.
# LLM_EMBEDDING_MAX_CHARS=6000

# Instruction prefixed to SEARCH QUERIES only (never to stored content) for
# instruction-tuned models. Auto-enabled for qwen3-embedding*; set to empty to
# disable, or to custom text to override. See scripts/eval-retrieval.ts.
# LLM_QUERY_INSTRUCTION=
